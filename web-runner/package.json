{
  "name": "code-academy-webrunner",
  "private": true,
  "version": "0.0.1",
  "description": "Offline runners for Code Academy: HTML/CSS/JS sandbox, SQLite (sql.js) and Kotlin syntax (tree-sitter)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --experimental-sqlite --no-warnings test/sql.test.mjs && node test/web.test.mjs"
  },
  "dependencies": {
    "acorn": "8.14.1",
    "acorn-walk": "8.3.4",
    "sql.js": "1.13.0",
    "tree-sitter-wasms": "0.1.12",
    "web-tree-sitter": "0.20.8"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "playwright-core": "1.63.0"
  }
}
