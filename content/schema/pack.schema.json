{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeacademy.app/schema/pack.schema.json",
  "title": "Контент-пакет (этап курса)",
  "type": "object",
  "required": [
    "id",
    "version",
    "stage",
    "title",
    "language",
    "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Номер этапа программы из ТЗ"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "language": {
      "enum": [
        "python",
        "html",
        "css",
        "javascript",
        "sql",
        "kotlin",
        "bash",
        "none"
      ]
    },
    "minAppVersion": {
      "type": "integer",
      "minimum": 1
    },
    "requiresPacks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "object",
      "description": "Названия навыков для карты знаний: id → название",
      "additionalProperties": {
        "type": "string",
        "minLength": 2
      }
    },
    "projects": {
      "type": "array",
      "description": "Учебные проекты пакета: projects/<id>/project.json",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
