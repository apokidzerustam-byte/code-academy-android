  "commonMistakes": [
    {
      "mistake": "Нет аннотации типа у параметра",
      "fix": "Без типа параметр — строка. Пишите n: int.",
      "errorType": "TypeError"
    },
    {
      "mistake": "Имя в пути не совпадает с параметром функции",
      "fix": "\"/square/{n}\" → def square(n: int)."
    },
    {
      "mistake": "print вместо return",
      "fix": "Ответ API — то, что функция возвращает."
    },
    {
      "mistake": "Ошибка возвращена словарём",
      "fix": "Код ошибки задаёт raise HTTPException(status_code=404, …)."
    },
    {
      "mistake": "Обращение к словарю без проверки",
      "fix": "Неизвестный ключ → KeyError и код 500. Проверяйте in."
    }
  ]
}
