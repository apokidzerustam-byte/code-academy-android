  "commonMistakes": [
    {
      "mistake": "Нет await перед call_next",
      "fix": "call_next асинхронная: response = await call_next(request)."
    },
    {
      "mistake": "Слой не возвращает response",
      "fix": "Всегда возвращайте ответ: return response."
    },
    {
      "mistake": "Проверка доступа после call_next",
      "fix": "Проверяйте до call_next: иначе обработчик уже выполнится."
    },
    {
      "mistake": "Секреты в журнале",
      "fix": "Не пишите пароли, токены и ключи; пишите номер пользователя."
