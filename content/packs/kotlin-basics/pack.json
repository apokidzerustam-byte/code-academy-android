    "kt.when": "when и циклы",
    "kt.data": "data class и списки",
    "kt.syntax": "Синтаксические ошибки",
    "kt.class": "Классы: свойства и методы",
    "kt.ctor": "Главный конструктор",
    "kt.null": "Типы с null и безопасный вызов",
    "kt.smartcast": "Проверка на null",
