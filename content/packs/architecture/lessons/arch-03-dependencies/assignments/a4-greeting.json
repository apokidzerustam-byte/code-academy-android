  "solution": "def greeting(hour):\n    if 5 <= hour <= 11:\n        return \"Доброе утро\"\n    if 12 <= hour <= 17:\n        return \"Добрый день\"\n    if 18 <= hour <= 22:\n        return \"Добрый вечер\"\n    return \"Доброй ночи\"\n",
