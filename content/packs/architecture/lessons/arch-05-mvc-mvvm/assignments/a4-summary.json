  "solution": "def summary(state):\n    items = state[\"items\"]\n    total = len(items)\n    done = sum(1 for item in items if item[\"done\"])\n    percent = round(100 * done / total) if total else 0\n    return {\"left\": total - done, \"total\": total, \"percent\": percent}\n",
