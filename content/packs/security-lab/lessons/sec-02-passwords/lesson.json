  "commonMistakes": [
    {
      "mistake": "Хранят пароль или его обратимое «шифрование»",
      "fix": "Храните соль и хеш; пароль восстановить нельзя и не нужно."
    },
    {
      "mistake": "Используют быстрый sha256 без соли",
      "fix": "Берите pbkdf2_hmac (или bcrypt/argon2) и случайную соль для каждого пользователя."
    },
    {
      "mistake": "Генерируют соль через random",
      "fix": "random предсказуем; для безопасных значений — модуль secrets."
    },
    {
      "mistake": "Сравнивают хеши через ==",
      "fix": "Используйте hmac.compare_digest."
    }
  ]
}
