{
  "id": "sec-02-passwords",
  "title": "Хеширование паролей",
  "goal": "Хранить пароли безопасно: соль, медленный хеш, постоянное по времени сравнение.",
  "skills": [
    "sec.hash",
    "sec.salt",
    "sec.pbkdf2"
  ],
  "prerequisites": [
