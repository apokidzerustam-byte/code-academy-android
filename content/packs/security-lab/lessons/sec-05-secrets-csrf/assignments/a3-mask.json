{
  "id": "a3-mask",
  "type": "function",
  "title": "Маска секрета",
  "statement": "Напишите `mask(secret)`: верните строку той же длины, где все символы, кроме **последних четырёх**, заменены на `*`. Если длина не больше 4 — все символы `*`.",
  "goal": "Маска секрета",
  "input": "Аргументы функции из условия.",
  "expectedResult": "Значение, которое возвращает функция.",
  "constraints": [],
  "hints": [
    "Покажите только хвост строки.",
    "Хвост: последние четыре символа — срез с отрицательным индексом.",
    "Остальное — звёздочки: умножение строки на число.",
    "Для коротких секретов показывать нечего.",
    "Длина не больше 4 — вернуть звёздочки по длине."
  ],
  "tests": {
    "kind": "function",
    "function": "mask",
    "cases": [
      {
        "args": [
          "key-12345"
        ],
        "id": "v1",
        "expected": "*****2345"
      },
      {
        "args": [
          "abc"
        ],
        "id": "v2",
        "expected": "***"
      },
      {
        "args": [
          "abcd"
        ],
        "id": "h3",
        "hidden": true,
        "expected": "****"
      },
      {
        "args": [
          "abcde"
        ],
        "id": "h4",
        "hidden": true,
        "expected": "*bcde"
      },
      {
        "args": [
          ""
        ],
        "id": "h5",
        "hidden": true,
        "expected": ""
      },
