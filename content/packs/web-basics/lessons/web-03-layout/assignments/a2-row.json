    {
      "code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Задание</title>\n  <style>\n    a { display: block; }\n    .menu {\n      display: flex;\n      gap: 10px;\n    }\n  </style>\n</head>\n<body>\n  <nav class=\"menu\">\n    <a href=\"#\">Главная</a>\n    <a href=\"#\">Курсы</a>\n    <a href=\"#\">Контакты</a>\n  </nav>\n</body>\n</html>\n",
      "why": "Промежуток не 20px."
