  "starterCode": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Лайки</title>\n</head>\n<body>\n  <button id=\"like\">Нравится</button>\n  <p>Лайков: <span id=\"likes\">0</span></p>\n  <script>\n    // ваш код\n  </script>\n</body>\n</html>\n",
  "hints": [
    "Сначала найдите кнопку: document.getElementById(\"like\").",
