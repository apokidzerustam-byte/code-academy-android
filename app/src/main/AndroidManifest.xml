<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".CodeAcademyApp"
        android:allowBackup="false"
        android:label="Code Academy"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeAcademy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".editor.EditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- Уровень A: отдельный процесс, ограничения на уровне Python. -->
        <service
            android:name=".runner.RunnerService"
            android:exported="false"
            android:process=":runner" />

        <!-- Уровень B: изолированный процесс (свой UID, SELinux isolated_app). -->
        <service
            android:name=".runner.IsolatedRunnerService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":iso_runner" />
        <!-- ИИ-наставник: llama.cpp в отдельном процессе (нехватка памяти не роняет приложение). -->
        <service
            android:name=".mentor.MentorService"
            android:exported="false"
            android:process=":mentor" />
    </application>
</manifest>
